    "condition": {
      "regexFilter": "^https://www\\.google\\.com/maps([/?]|$)",
      "isUrlFilterCaseSensitive": true,
      "resourceTypes": ["main_frame"],
      "requestMethods": ["get"]
    }
  }
]
